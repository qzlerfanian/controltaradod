[Unit]
Description=Rahband React dashboard
After=network-online.target anpr.service
Wants=network-online.target

[Service]
Type=simple
User=b3-rahband
Group=b3-rahband
WorkingDirectory=/data/projects/rahband/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
