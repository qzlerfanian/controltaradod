[Unit]
Description=Rahband ANPR API and camera workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rahband
Group=rahband
WorkingDirectory=/data/projects/rahband/backend
EnvironmentFile=/data/projects/rahband/backend/.env
ExecStart=/data/projects/rahband/backend/.venv/bin/uvicorn rahband.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/projects/rahband/runtime /var/log/rahband

[Install]
WantedBy=multi-user.target
